# Development server port
VITE_PORT=7034

# Netlify OAuth Client ID (required for publishing)
# Get this from: https://app.netlify.com/user/applications
# Create a new OAuth app with redirect URI: https://writelocal.test/
VITE_NETLIFY_CLIENT_ID=your-client-id-here

# Base URL (optional, for production deployments)
# VITE_BASE_URL=/
